#!/bin/sh
# Bloqueia commit que contenha credencial.
# Mira no VALOR atribuido a uma chave, nao na mencao da palavra, para nao
# barrar a propria documentacao que trata do assunto.
# O proprio diretorio .githooks fica de fora da varredura: ele descreve os
# padroes que procura, entao sempre casaria consigo mesmo.
#
# DESENHO FAIL-CLOSED: qualquer defeito no proprio mecanismo (isencao vazia,
# isencao afrouxada, erro na varredura, extracao de valor falha) BARRA o commit
# em vez de deixar passar. Guarda que quebra tem de quebrar fechada.
set -u

FOUND=0

# ---------------------------------------------------------------------------
# ISENCOES do padrao "credencial atribuida": formas que o padrao acusa mas que
# comprovadamente nao sao credencial. Avaliadas sobre o VALOR isolado do nome da
# chave e ANCORADAS, para nao virarem porta de fuga (senha literal comecando por
# $ ou {). Cada uma exige forma plausivel inteira, nunca so o primeiro caractere.
# Metodo e evidencia: Second_Brain/20-padroes/calibrar-guarda-por-isencao-com-teste-adversarial.md
#   REF   referencia a variavel/subshell, nome em CAIXA ALTA: $SEC ${VAR:-} $(cmd) {SEC}
#   MASC  valor inteiramente mascarado: ****
#   PLACE placeholder de documentacao, LISTA FECHADA (nao "qualquer caixa alta")
# ---------------------------------------------------------------------------
ISENTA_REF='^["'"'"']?(\$\(|\$\{?[A-Z_][A-Z0-9_]*|\{[A-Z_][A-Z0-9_]*\}|-\})'
ISENTA_MASC='^["'"'"']?\*+[^A-Za-z0-9]*$'
ISENTA_PLACE='^["'"'"']?(YOURPASS|YOURPASSWORD|SUASENHA|CHANGEME|PASSWORD|SENHA|NO|X{3,}|x{3,})[^A-Za-z0-9]*$'
#   URL   valor que e um endereco. Credencial embutida em URL ja tem padrao
#         proprio mais abaixo (://user:senha@), entao isentar aqui nao abre buraco.
ISENTA_URL='^["'"'"']?(https?|ftp)://'

# Guarda 1: isencao vazia ou universal casaria tudo e desligaria a protecao.
for _v in "$ISENTA_REF" "$ISENTA_MASC" "$ISENTA_PLACE" "$ISENTA_URL"; do
  case "$_v" in
    ''|'^'|'$'|'.'|'.*'|'^.*$'|'^$')
      echo "pre-commit: isencao vazia ou universal detectada. Abortando por seguranca." >&2
      exit 1 ;;
  esac
done

# Guarda 2: autoteste com canarios. Sao credenciais literais desenhadas para se
# disfarcar de cada isencao. Se QUALQUER isencao passar a aceitar uma delas,
# alguem afrouxou o criterio e o hook se recusa a rodar prometendo menos do que
# protege.
for _c in 'hunter2correcthorse' '$ecreto123Real' '{Tr0vao2026}' 'SEGREDOFORTE' 'httpsecreto123'; do
  if printf '%s' "$_c" | grep -qE "$ISENTA_REF" ||
     printf '%s' "$_c" | grep -qE "$ISENTA_MASC" ||
     printf '%s' "$_c" | grep -qE "$ISENTA_PLACE" ||
     printf '%s' "$_c" | grep -qE "$ISENTA_URL"; then
    echo "pre-commit: autoteste falhou, uma isencao aceita o canario '$_c'." >&2
    echo "Abortando por seguranca. Restaure o hook do backup." >&2
    exit 1
  fi
done

# Arquivos staged (adicionados ou modificados)
FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$FILES" ] && exit 0

# check PADRAO ROTULO [isentar]
# O terceiro argumento liga as isencoes. So o padrao de chave=valor as usa: os
# demais nao tem esse formato, e manter a isencao longe deles reduz a superficie
# onde ela poderia agir por engano.
# check PADRAO ROTULO [isentar] [exigir_misto]
# exigir_misto=sim so barra quando o VALOR tem forma de segredo (letra e digito,
# 12+ chars). Existe para o PAT_IDENT, cujo casamento de nome e frouxo de
# proposito: sem esse contrapeso ele acusaria identificador comum de codigo.
check() {
  PATTERN="$1"
  LABEL="$2"
  ISENTAR="${3:-nao}"
  EXIGIR_MISTO="${4:-nao}"
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in .githooks/*) continue ;; esac

    if [ "$ISENTAR" != "sim" ]; then
      HITS=$(grep -nEi "$PATTERN" "$f" 2>/dev/null)
      rc=$?
      if [ "$rc" -gt 1 ]; then
        echo ""
        echo "BLOQUEADO [erro na varredura, rc=$rc] em $f"
        FOUND=1
        continue
      fi
    else
      RAW=$(grep -noEi "$PATTERN" "$f" 2>/dev/null)
      rc=$?
      if [ "$rc" -gt 1 ]; then
        echo ""
        echo "BLOQUEADO [erro na varredura, rc=$rc] em $f"
        FOUND=1
        continue
      fi
      HITS=$(printf '%s\n' "$RAW" | while IFS= read -r hit; do
        [ -n "$hit" ] || continue
        match="${hit#*:}"
        # Extracao do valor. Se falhar ou vier vazia, cai para o match inteiro,
        # que nao casa nenhuma isencao ancorada: na duvida, barra.
        valor=$(printf '%s' "$match" | sed -E 's/^[^:=]*[:=][[:space:]]*//' 2>/dev/null) || valor="$match"
        [ -n "$valor" ] || valor="$match"
        printf '%s' "$valor" | grep -qE "$ISENTA_REF"   && continue
        printf '%s' "$valor" | grep -qE "$ISENTA_MASC"  && continue
        printf '%s' "$valor" | grep -qE "$ISENTA_PLACE" && continue
        printf '%s' "$valor" | grep -qE "$ISENTA_URL"   && continue
        if [ "$EXIGIR_MISTO" = "sim" ]; then
          valor_misto "$valor" || continue
        fi
        printf '%s\n' "$hit"
      done)
    fi

    if [ -n "$HITS" ]; then
      echo ""
      echo "BLOQUEADO [$LABEL] em $f:"
      echo "$HITS" | head -5
      FOUND=1
    fi
  done
}

# Os padroes vivem em variaveis para que a Guarda 3 (autoteste de deteccao,
# mais abaixo) possa exercita-los antes de qualquer varredura.
# Duas formas, deliberadamente separadas.
#   A: nome nao aspado, separador, valor.            password = valor
#   B: forma JSON, que exige aspa dos DOIS lados.    "api_key": "valor"
# Uma aspa opcional so do lado da chave, que foi a primeira tentativa, criava
# falso positivo: em `"$PWD":/app` o `PWD"` virava nome e `/app` virava valor.
# Achado por revisao adversarial da sessao irmã em 24/08/2026, sobre 120 notas.
# Exigir a aspa tambem no valor separa JSON de caminho sem perder cobertura.
PAT_KV='((senha|password|passwd|pwd|secret|token|api[_-]?key|auth[_-]?key)[[:space:]]*[:=][[:space:]]*[^[:space:]<>[]{3,})|((senha|password|passwd|pwd|secret|token|api[_-]?key|auth[_-]?key)["'"'"'][[:space:]]*:[[:space:]]*["'"'"'][^"'"'"'[:space:]<>[]{3,})'
# Fecha a lacuna do separador colado: 'senha do painel: xxx' escapava do PAT_KV,
# e e a forma mais natural de escrever credencial em documentacao de atendimento
# em portugues. As palavras entre a chave e o separador sao LISTA FECHADA de
# conectivos, nao "qualquer palavra": alargar sem isso acusaria prosa comum.
PAT_QUAL='(senha|password|passwd|pwd|secret|token|api[_-]?key|auth[_-]?key)([[:space:]]+(do|da|de|dos|das|para|no|na|em|ao|aos|of|for|the)[[:space:]]+[[:alpha:]àáâãéêíóôõúçÀÁÂÃÉÊÍÓÔÕÚÇ]+){1,2}[[:space:]]*[:=][[:space:]]*[^[:space:]<>[]{3,}'
PAT_KEY='\-\-\-\-\-BEGIN [A-Z ]*PRIVATE KEY\-\-\-\-\-'
PAT_URL='://[a-z0-9._%-]+:[^@[:space:]/]+@'
# sshpass: exige que o argumento de -p seja um valor LITERAL. O padrao anterior
# casava a mera mencao do comando, contra o principio declarado no topo deste
# arquivo, e acusava dois artigos da base de conhecimento que ensinam o rsync
# com 'sshpass -p $(cat .password)', que e referencia a arquivo, nao senha.
PAT_SSHPASS='sshpass[[:space:]]+-p[[:space:]]*["'"'"']?[A-Za-z0-9]'

# PAT_IDENT: a palavra-chave DENTRO de um identificador maior.
# 'meu_treco_secreto = "aB3xY9kL2mN8pQ4r"' escapava porque o PAT_KV exige que o
# nome termine exatamente na palavra. Aqui o nome pode ter prefixo e sufixo.
# Contrapeso, porque o casamento de nome ficou frouxo: o VALOR precisa ter forma
# de segredo, verificada em VALOR_MISTO (letra e digito juntos, 12+ chars).
# Sem esse contrapeso, 'tokenizer = MinhaClasse' viraria falso positivo.
PAT_IDENT='[A-Za-z0-9_]*(senha|password|passwd|secret|token|api[_-]?key)[A-Za-z0-9_]*["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?[A-Za-z0-9+/=_-]{12,}'

# PAT_B64: base64 com 20+ caracteres. Sozinho isso seria ruidoso demais, entao o
# padrao so LOCALIZA candidatos; quem decide e a decodificacao feita em check_b64,
# que barra apenas quando o texto decodificado contem palavra de credencial.
PAT_B64='[A-Za-z0-9+/]{20,}={0,2}'

# Valor com forma de segredo: precisa ter letra E digito, 12+ chars. E o
# contrapeso do PAT_IDENT, cujo casamento de nome e deliberadamente frouxo.
valor_misto() {
  v=$(printf '%s' "$1" | sed -E 's/^["'"'"']//; s/["'"'"',;].*$//')
  [ "${#v}" -ge 12 ] || return 1
  printf '%s' "$v" | grep -q '[A-Za-z]' || return 1
  printf '%s' "$v" | grep -q '[0-9]'    || return 1
  return 0
}

# Decodifica base64 e barra se o texto revelado contiver palavra de credencial.
# Aceita as duas formas do utilitario (-d no GNU, -D no BSD/macOS). Se nenhuma
# decodificar, o candidato e ignorado: base64 ilegivel nao e prova de nada.
b64_revela_credencial() {
  dec=$(printf '%s' "$1" | base64 -d 2>/dev/null) ||
  dec=$(printf '%s' "$1" | base64 -D 2>/dev/null) || return 1
  [ -n "$dec" ] || return 1
  printf '%s' "$dec" | grep -qEi '(senha|password|passwd|secret|token|api[_-]?key|BEGIN [A-Z ]*PRIVATE KEY)'
}

check_b64() {
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in .githooks/*) continue ;; esac
    hits=$(grep -noE "$PAT_B64" "$f" 2>/dev/null)
    rc=$?; [ "$rc" -gt 1 ] && { echo ""; echo "BLOQUEADO [erro na varredura b64, rc=$rc] em $f"; FOUND=1; continue; }
    achou=$(printf '%s\n' "$hits" | while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      cand="${hit#*:}"
      b64_revela_credencial "$cand" && printf '%s\n' "${hit%%:*}: <base64 que decodifica para credencial>"
    done)
    if [ -n "$achou" ]; then
      echo ""; echo "BLOQUEADO [credencial em base64] em $f:"; echo "$achou" | head -5; FOUND=1
    fi
  done
}

# Guarda 3: autoteste de DETECCAO. As guardas 1 e 2 vigiam as isencoes; sem esta,
# afrouxar um PADRAO passava despercebido, que e o buraco simetrico. Cada linha
# abaixo TEM de casar o seu padrao; se deixar de casar, o hook aborta.
_det() { printf '%s' "$2" | grep -qEi "$1"; }
if ! _det "$PAT_KV"      'password = hunter2correcthorse'      ||
   ! _det "$PAT_QUAL"    'senha do painel: joao2026vix'        ||
   ! _det "$PAT_KEY"     '-----BEGIN RSA PRIVATE KEY-----'     ||
   ! _det "$PAT_URL"     'https://admin:senha123@host/api'     ||
   ! _det "$PAT_SSHPASS" 'sshpass -p MinhaSenha123 ssh host'   ||
   ! _det "$PAT_KV"      '{"api_key": "sk_live_51H8xQ2eZvKYlo2C"}' ||
   ! _det "$PAT_IDENT"   'meu_treco_secreto = "aB3xY9kL2mN8pQ4r"'  ||
   ! _det "$PAT_B64"     'cGFzc3dvcmQ9U3VwM3JTM2NyM3QwIQ=='; then
  echo "pre-commit: autoteste de deteccao falhou, um padrao deixou de pegar o" >&2
  echo "que deveria. Abortando por seguranca. Restaure o hook do backup." >&2
  exit 1
fi

# Guarda 4: os mecanismos novos tambem se autotestam. valor_misto tem de aceitar
# um segredo real e recusar um identificador de codigo; b64_revela_credencial tem
# de revelar o canario e ignorar base64 inocente. Se qualquer um inverter, aborta.
if ! valor_misto 'aB3xY9kL2mN8pQ4r' ||
     valor_misto 'MinhaClasseDeTeste' ||
   ! b64_revela_credencial 'cGFzc3dvcmQ9U3VwM3JTM2NyM3QwIQ==' ||
     b64_revela_credencial 'YnJhc2lsIGNhbXBlYW8gZG8gbXVuZG8='; then
  echo "pre-commit: autoteste dos mecanismos novos falhou. Abortando por seguranca." >&2
  exit 1
fi

check "$PAT_KV"      'credencial atribuida' sim
check "$PAT_QUAL"    'credencial com qualificador' sim
check "$PAT_KEY"     'chave privada'
check "$PAT_URL"     'credencial embutida em URL'
check "$PAT_SSHPASS" 'senha em linha de comando'
check "$PAT_IDENT"   'credencial em identificador' sim sim
check_b64

if [ "$FOUND" -eq 1 ]; then
  cat <<'EOF'

------------------------------------------------------------------
Commit bloqueado: possivel credencial no conteudo.

Estes arquivos sao documentacao de atendimento, nao cofre de senhas.
Guarde a credencial no gerenciador de senhas e deixe aqui apenas a
referencia de onde ela esta.

Se for falso positivo (exemplo, texto explicando a regra), refaca o
commit com:  git commit --no-verify
------------------------------------------------------------------
EOF
  exit 1
fi

exit 0
